@article{chen_wu_sturt,
  abbr     = {reading},
  title    = {Selective rereading in Chinese garden path sentences},
  author   = {Chen, Huandi and Wu, Min-Tzu and Sturt, Patrick},
  year = {2026},
  journal  = {Journal of Experimental Psychology: Learning, Memory, and Cognition, 52(9), 1655},
  doi      = {https://doi.org/10.1037/xlm0001558},
  abstract = {Regressive eye movements are commonly observed in response to syntactic ambiguities, yet their characteristics and role in ambiguity resolution remain unclear. This study examined two key questions about rereading in Chinese garden-path sentences: (1) whether rereading is selective, meaning that readers allocate more or longer fixations to specific regions following garden-path disambiguation and (2) whether rereading facilitates comprehension by aiding the recovery of the globally correct interpretation. We therefore conducted an eye-tracking experiment on sentences featuring a naturally occurring syntactic ambiguity (NP1 + VP + NP2 + de + NP3). The results provide clear evidence of selective rereading, as readers refixated the ambiguous region after encountering processing difficulty. However, these refixations did not aid ambiguity resolution, suggesting that while regressions reflect sensitivity to processing disruptions, they do not always contribute to successful reinterpretation.},
  dataset  = {https://osf.io/3j4yr/?view_only=c354bf1ff93342f1bdda5a0b235a1ef1},
  selected = {true}
}

@article{chen_bosker,
  abbr     = {gesture},
  title    = {Gesturing at the Boundary: Can Concurrent Beat Gestures Bias Speech Segmentation?},
  author   = {Chen, Huandi and Bosker, Hans Rutger},
  year = {2026},
  journal  = {PsyArXiv (preprint)},
  html      = {https://osf.io/preprints/psyarxiv/qrzgf_v1},
  abstract = {Beat gestures, rhythmic hand movements that reliably co-occur with prosodically prominent syllables, areone of the most common types of gestures in everyday conversations. Given their coupling to speech prosody, they can influence stress perception and facilitate lexical access.Still, little is known about their contribution to speech segmentation.Recent work has shown that beat gestures conveying distinct rhythms in a precursor (i.e., distalcontext)can bias the segmentation of subsequently presented acoustically ambiguous speech (Bosker, 2026). However, whether a single beat gesture co-occurring with the ambiguous speech (i.e., proximalcontext) can similarly shift boundary placement remains unknown. Across two experiments, participants segmented acoustically ambiguous four-syllable sequences (e.g., cry sister nipvs. crisis turnip) while a beat gesture wasaligned to either the second or third syllable. Unexpectedly, no reliable effect of gesture placement on segmentation was observed. These findings suggest that isolated beat gestures maynot function as reliable independent cues to speech segmentation. Instead, their influence may depend on the broader audiovisual and rhythmic context.},
  dataset  = {https://osf.io/qncaz},
  selected = {true}
}
